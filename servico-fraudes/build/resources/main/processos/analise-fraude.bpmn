<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_AnaliseFraude"
                  targetNamespace="http://banksystem.com.br/fraudes"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

    <bpmn:process id="processoAnaliseFraude"
                  name="Processo de Análise de Fraude"
                  isExecutable="true"
                  camunda:historyTimeToLive="P30D"
                  camunda:versionTag="v1.0">

        <!-- Start -->
        <bpmn:startEvent id="inicioProcesso" name="Transação Recebida">
            <bpmn:outgoing>fluxo1</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- Flow -->
        <bpmn:sequenceFlow id="fluxo1" sourceRef="inicioProcesso" targetRef="verificarRisco"/>

        <!-- External Task: verificar risco -->
        <bpmn:serviceTask id="verificarRisco"
                          name="Verificar Risco da Transação"
                          camunda:type="external"
                          camunda:topic="verificar-risco">
            <bpmn:incoming>fluxo1</bpmn:incoming>
            <bpmn:outgoing>fluxo2</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:sequenceFlow id="fluxo2" sourceRef="verificarRisco" targetRef="decisaoRisco"/>

        <!-- Gateway -->
        <bpmn:exclusiveGateway id="decisaoRisco" name="Alto Risco?" default="fluxoBaixoRisco">
            <bpmn:incoming>fluxo2</bpmn:incoming>
            <bpmn:outgoing>fluxoAltoRisco</bpmn:outgoing>
            <bpmn:outgoing>fluxoBaixoRisco</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <!-- High risk -->
        <bpmn:sequenceFlow id="fluxoAltoRisco"
                           name="Sim"
                           sourceRef="decisaoRisco"
                           targetRef="bloquearTransacao">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${altoRisco == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <!-- Low risk -->
        <bpmn:sequenceFlow id="fluxoBaixoRisco"
                           name="Não"
                           sourceRef="decisaoRisco"
                           targetRef="aprovarTransacao"/>

        <!-- External Task: bloquear -->
        <bpmn:serviceTask id="bloquearTransacao"
                          name="Bloquear e Notificar Fraude"
                          camunda:type="external"
                          camunda:topic="bloquear-transacao">
            <bpmn:incoming>fluxoAltoRisco</bpmn:incoming>
            <bpmn:outgoing>fluxo3</bpmn:outgoing>
        </bpmn:serviceTask>

        <!-- External Task: aprovar -->
        <bpmn:serviceTask id="aprovarTransacao"
                          name="Aprovar e Notificar"
                          camunda:type="external"
                          camunda:topic="aprovar-transacao">
            <bpmn:incoming>fluxoBaixoRisco</bpmn:incoming>
            <bpmn:outgoing>fluxo4</bpmn:outgoing>
        </bpmn:serviceTask>

        <!-- End flows -->
        <bpmn:sequenceFlow id="fluxo3" sourceRef="bloquearTransacao" targetRef="fimProcesso"/>
        <bpmn:sequenceFlow id="fluxo4" sourceRef="aprovarTransacao" targetRef="fimProcesso"/>

        <!-- End -->
        <bpmn:endEvent id="fimProcesso" name="Processo Concluído">
            <bpmn:incoming>fluxo3</bpmn:incoming>
            <bpmn:incoming>fluxo4</bpmn:incoming>
        </bpmn:endEvent>

    </bpmn:process>

    <!-- BPMN DI -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_AnaliseFraude">
        <bpmndi:BPMNPlane id="BPMNPlane_AnaliseFraude" bpmnElement="processoAnaliseFraude">

            <!-- Start -->
            <bpmndi:BPMNShape id="inicioProcesso_di" bpmnElement="inicioProcesso">
                <dc:Bounds x="120" y="160" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="92" y="202" width="92" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- verificarRisco -->
            <bpmndi:BPMNShape id="verificarRisco_di" bpmnElement="verificarRisco">
                <dc:Bounds x="220" y="138" width="120" height="80"/>
            </bpmndi:BPMNShape>

            <!-- gateway -->
            <bpmndi:BPMNShape id="decisaoRisco_di" bpmnElement="decisaoRisco" isMarkerVisible="true">
                <dc:Bounds x="390" y="153" width="50" height="50"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="380" y="124" width="70" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- bloquear -->
            <bpmndi:BPMNShape id="bloquearTransacao_di" bpmnElement="bloquearTransacao">
                <dc:Bounds x="520" y="80" width="140" height="80"/>
            </bpmndi:BPMNShape>

            <!-- aprovar -->
            <bpmndi:BPMNShape id="aprovarTransacao_di" bpmnElement="aprovarTransacao">
                <dc:Bounds x="520" y="240" width="140" height="80"/>
            </bpmndi:BPMNShape>

            <!-- end -->
            <bpmndi:BPMNShape id="fimProcesso_di" bpmnElement="fimProcesso">
                <dc:Bounds x="740" y="160" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="700" y="202" width="116" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- fluxo1 -->
            <bpmndi:BPMNEdge id="fluxo1_di" bpmnElement="fluxo1">
                <di:waypoint x="156" y="178"/>
                <di:waypoint x="220" y="178"/>
            </bpmndi:BPMNEdge>

            <!-- fluxo2 -->
            <bpmndi:BPMNEdge id="fluxo2_di" bpmnElement="fluxo2">
                <di:waypoint x="340" y="178"/>
                <di:waypoint x="390" y="178"/>
            </bpmndi:BPMNEdge>

            <!-- fluxoAltoRisco -->
            <bpmndi:BPMNEdge id="fluxoAltoRisco_di" bpmnElement="fluxoAltoRisco">
                <di:waypoint x="440" y="178"/>
                <di:waypoint x="470" y="178"/>
                <di:waypoint x="470" y="120"/>
                <di:waypoint x="520" y="120"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="470" y="140" width="20" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNEdge>

            <!-- fluxoBaixoRisco -->
            <bpmndi:BPMNEdge id="fluxoBaixoRisco_di" bpmnElement="fluxoBaixoRisco">
                <di:waypoint x="440" y="178"/>
                <di:waypoint x="470" y="178"/>
                <di:waypoint x="470" y="280"/>
                <di:waypoint x="520" y="280"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="470" y="228" width="24" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNEdge>

            <!-- fluxo3 -->
            <bpmndi:BPMNEdge id="fluxo3_di" bpmnElement="fluxo3">
                <di:waypoint x="660" y="120"/>
                <di:waypoint x="700" y="120"/>
                <di:waypoint x="700" y="178"/>
                <di:waypoint x="740" y="178"/>
            </bpmndi:BPMNEdge>

            <!-- fluxo4 -->
            <bpmndi:BPMNEdge id="fluxo4_di" bpmnElement="fluxo4">
                <di:waypoint x="660" y="280"/>
                <di:waypoint x="700" y="280"/>
                <di:waypoint x="700" y="178"/>
                <di:waypoint x="740" y="178"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>